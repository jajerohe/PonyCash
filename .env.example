# Cadena de conexión de Neon (botón "Connect" del proyecto)
DATABASE_URL="postgresql://usuario:contraseña@ep-xxxx.neon.tech/neondb?sslmode=require"

# Clave secreta para firmar las sesiones: cualquier texto aleatorio largo (32+ caracteres).
BETTER_AUTH_SECRET="cambia-esto-por-un-texto-aleatorio-largo"

# (Opcional) Dirección pública de la app. Si no se pone, se toma de cada visita.
# BETTER_AUTH_URL="https://ponycash.tu-cuenta.workers.dev"
