# Cadena de conexión de Neon (botón "Connect" del proyecto)
DATABASE_URL="postgresql://usuario:contraseña@ep-xxxx.neon.tech/neondb?sslmode=require"

# Clave secreta para firmar las sesiones. Genera una con:  npx auth secret
# o con cualquier texto aleatorio largo (32+ caracteres).
BETTER_AUTH_SECRET="cambia-esto-por-un-texto-aleatorio-largo"

# Dirección donde corre la app
BETTER_AUTH_URL="http://localhost:3000"
